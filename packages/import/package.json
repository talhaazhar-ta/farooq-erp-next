{
  "name": "@farooq/import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Legacy backup JSON -> Postgres importer + reconciliation report (the \"100%\" safety net).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test fixtures --max-warnings=0",
    "test": "vitest run",
    "import": "tsx src/cli.ts",
    "fixture": "tsx fixtures/build-fixture.ts"
  },
  "dependencies": {
    "@farooq/db": "workspace:*",
    "@farooq/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
