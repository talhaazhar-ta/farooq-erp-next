# Admin/migration connection — creates tables, creates/updates the farooq_app role.
# Never point this at the live ERP's databases (u943531942_facotraders / u943531942_erpauth).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farooq_erp

# Least-privilege connection the running API actually uses. Username must be
# "farooq_app" (see src/db/env.ts) — only the password is environment-specific.
APP_DATABASE_URL=postgresql://farooq_app:change-me@localhost:5432/farooq_erp

# Owner seed (src/db/seed.ts) — never hardcode a real password anywhere else.
OWNER_USERNAME=owner
OWNER_NAME=Owner
OWNER_PASSWORD=change-me

PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
